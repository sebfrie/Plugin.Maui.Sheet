<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Plugin.Maui.Sheet.Sample"
             x:Class="Plugin.Maui.Sheet.Sample.ServiceSheetView"
             x:DataType="local:ServiceSheetViewModel">
    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="This view was created with constructor injection and shown with ShowSheetAsync&lt;ServiceSheetView, string&gt;(). Your pick is returned to the calling view model." />
        <Label Text="{Binding OpenedAt, StringFormat='Opened at {0:T}'}" FontAttributes="Bold" />
        <Button Text="Apple" Command="{Binding PickCommand}" CommandParameter="Apple" />
        <Button Text="Banana" Command="{Binding PickCommand}" CommandParameter="Banana" />
        <Button Text="Cherry" Command="{Binding PickCommand}" CommandParameter="Cherry" />
    </VerticalStackLayout>
</ContentView>
