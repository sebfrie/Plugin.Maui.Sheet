<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Plugin.Maui.Sheet.Sample"
             x:Class="Plugin.Maui.Sheet.Sample.ServiceSheetView"
             x:DataType="local:ServiceSheetViewModel">
    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="This view was resolved from DI and shown with ShowSheetAsync&lt;ServiceSheetView&gt;(). The sheet sizes itself to this content (FitContent)." />
        <Label Text="{Binding OpenedAt, StringFormat='Opened at {0:T}'}" FontAttributes="Bold" />
        <Button Text="Close via CloseSheetAsync()" Command="{Binding CloseCommand}" />
    </VerticalStackLayout>
</ContentView>
